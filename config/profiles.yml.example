dbt_project:
  target: local_postgres
  outputs:
    local_postgres:
      type: postgres
      host: "{{ env_var('DB_HOST', 'localhost') }}"
      user: "{{ env_var('DB_USER', 'postgres') }}"
      password: "{{ env_var('DB_PASSWORD', 'postgres') }}"
      port: "{{ env_var('DB_PORT', '5432') | int }}"
      dbname: "{{ env_var('DB_NAME', 'ravenstack_db') }}"
      schema: silver
      threads: 4

    cloud_bigquery:
      type: bigquery
      method: oauth
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: silver
      location: "{{ env_var('BQ_LOCATION', 'US') }}"
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
